{"schema_version":1,"record_type":"chunk","chunk":{"chunk_id":"chunk_893ddb9e72250ef05c98e281ed5d6470e010270faeedd4cf1722c72820e796b2","repository_id":"fixture.baseline","commit":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","relative_path":"pkg/parser.py","symbol_name":"parse","symbol_type":"function","start_line":4,"end_line":11,"language":"python","content":"def parse(raw: str) -> dict[str, str]:\n    \"\"\"Return stripped key/value pairs.\"\"\"\n\n    result: dict[str, str] = {}\n    for line in raw.splitlines():\n        key, value = line.split(\"=\", maxsplit=1)\n        result[key.strip()] = value.strip()\n    return result\n","content_hash":"f17d3d6880c94529b944145a4066733e0fb2caa29eb17281219cfdb76f7102d5","metadata":{"source_id":"src_3e963298f76d36f594dff1d846c56779b6167e27e42393e87dd2e323a795f0c3","source_content_hash":"1e7c9a2362d5629b739e6e4f8757d787ba9b26b79090cc3731e23b9564f069b0","chunk_mode":"ast","ast_kind":"function","processor":"python_ast_v1","part_index":0,"part_count":1,"max_lines":200,"overlap_lines":20}}}
